NODE_ENV=production
HOST=127.0.0.1
PORT=12000
MONGO_URI=mongodb://h_chat:CHANGE_ME@127.0.0.1:27017/h_chat?authSource=h_chat
APP_ORIGIN=https://chat.omranisystems.com
ADMIN_ORIGIN=https://adminchat.omranisystems.com
# openssl rand -hex 48
JWT_SECRET=
ADMIN_JWT_SECRET=
# Same SMTP account as passwordManager (EMAIL_* in its .env)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_FROM=
EMAIL_PASSWORD=
# Must match static-auth-secret in /etc/turnserver.conf
TURN_SECRET=
# Optional: comma-separated relay URLs handed to clients
# TURN_URLS=turn:turn.omranisystems.com:3478?transport=udp,...
MEDIA_DIR=/var/lib/h-chat/media
MOBILE_BUILDS_DIR=/projects/mobile_builds
